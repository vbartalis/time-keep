# SQLite database file. Production image: /data/time-keep.db.
DATABASE_PATH=./data/time-keep.db
# First-start admin, used only while no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Listen port (default 3000).
PORT=3000
# Behind a proxy only; unset locally. The image sets these for Coolify's proxy.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# A local `node build` over plain http needs PROTOCOL_HEADER=x-forwarded-proto and a client sending `x-forwarded-proto: http`, or form posts are refused.
